# Copy to .env. Leave BASE_URL empty to test the bundled demo app.
# Use a preview/staging URL, not production.
BASE_URL=

# A test account made for these tests. Never a real user's login.
# The values below are the demo app's seed account.
TEST_EMAIL=test@example.com
TEST_PASSWORD=test-password-123

# Domain for sign-up test emails (default example.com). Use one you control
# if the app sends confirmation emails.
SIGNUP_EMAIL_DOMAIN=

# Demo app only: auth | save | leak to show a test catching a bug.
DEMO_BUG=
